# CMDB MCP adapter — environment variable reference.
#
# Copy this file to `.env` and fill in real values.  `.env` is
# git-ignored and is the only place a real secret should live.  This
# file documents variable *names* only; every value below is a
# placeholder or a fake that must be replaced before use.
#
# Precedence (highest wins): CLI flags (http --host/--port) > env vars
# > safe defaults.  See docs/configuration-security-observability.md.

# --- Inbound / runtime domain (MCP_*) -----------------------------------

# Address the HTTP transport binds to.  Loopback (127.0.0.1, ::1,
# localhost) may run without a token; any other value REQUIRES
# MCP_AUTH_TOKEN (fail closed).
#MCP_BIND_HOST=127.0.0.1

# TCP port the HTTP transport binds to (1-65535).
#MCP_PORT=8000

# Which CMDB adapter to use.  MVP: "mock" (in-process) or "veops" (the
# real VeOps CMDB; requires VEOPS_BASE_URL and the VEOPS_KEY +
# VEOPS_SECRET credential pair — see the 0.2.0 migration note below).
#MCP_ADAPTER=mock

# Inbound bearer token authenticating *clients* of this adapter's HTTP
# endpoint.  Required whenever MCP_BIND_HOST is not a loopback address.
# Rotate by changing this value and restarting the process.
#MCP_AUTH_TOKEN=z9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4

# Upstream HTTP timeout in seconds (default 30).
#MCP_HTTP_TIMEOUT=30

# Maximum retries for idempotent (read) upstream operations (default 2).
# Write operations are never retried regardless of this value.
#MCP_HTTP_MAX_RETRIES=2

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default INFO).
#MCP_LOG_LEVEL=INFO

# --- Upstream CMDB domain (VEOPS_*) --------------------------------------
# Independent from MCP_AUTH_TOKEN: these credentials authenticate the
# adapter *toward* the VeOps CMDB, not clients of the adapter.

# Base URL of the VeOps CMDB API.  Must be an http(s) URL; REQUIRED by
# the veops adapter and validated at startup (fail closed).  Point it
# at the VeOps nginx front (e.g. http://<host>:8000) — the API is
# mounted at /api/v0.1 under it.
#VEOPS_BASE_URL=https://cmdb.example.com/api

# VeOps user key/secret pair (from the VeOps *user management* page, or
# the users.key/users.secret columns).  VeOps 2.6.2 authenticates
# service calls per request with a key/secret signature (SHA-1 over
# path + secret + sorted scalar params; see docs/veops-adapter.md).
# Both are REQUIRED by the veops adapter (fail closed: the adapter will
# not start without them), unlike the mock adapter which needs no
# credentials.  The secret is registered with the log redaction filter
# and never appears in logs or error messages.
#
# 0.2.0 migration: the pre-0.2.0 single credential VEOPS_TOKEN is no
# longer used (one token cannot express a key/secret pair).  It is
# still read for diagnostics: if it is set while VEOPS_KEY /
# VEOPS_SECRET are missing, startup fails with a configuration error
# pointing at these two variables.
#VEOPS_KEY=your-veops-key
#VEOPS_SECRET=your-veops-secret
