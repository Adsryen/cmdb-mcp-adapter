__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.coverage
coverage.xml
htmlcov/

# Python environments and packaging outputs
.venv/
venv/
env/
ENV/
dist/
build/
*.egg-info/
pip-wheel-metadata/

# JavaScript tooling used by optional documentation or tooling
node_modules/
.npm/

# Local configuration and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Logs and local runtime state
*.log

# Temporary files
*.tmp
*.temp

# ide
.trae/

# Trellis, agent, and project instructions are repository context.
# Their tool-specific runtime files are ignored by the nested rules where
# applicable; do not ignore the entire directories or task/spec history.
.trellis/
.agents/
.project/
.task/
.spec/
.codex/
.claude/

# Local isolated VeOps test sandbox (pulled snapshot from intranet VeOps host)
veops-local-test/

# The ONLY rules file allowed in git is the committed hygiene copy
# (src/cmdb_mcp_adapter/rules/cmdb_rules.json — a redaction of the ops fact
# source: same structure and thresholds, internal values masked).  A
# ground-truth copy injected over it shows up as a modified tracked file and
# CI's hygiene guard fails it — never commit ground truth.
# See src/cmdb_mcp_adapter/rules/README.md.
